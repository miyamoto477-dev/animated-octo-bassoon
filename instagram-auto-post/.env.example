# ==========================================================
# instagram-auto-post 環境変数サンプル
# このファイルをコピーして「.env」という名前で保存し、値を入力してください。
# PowerShellでのコピー方法:
#   Copy-Item .env.example .env
# ==========================================================

# Meta for Developersで発行した長期アクセストークン（60日間有効）
# 短期トークンではなく「長期アクセストークン」を使ってください。
INSTAGRAM_ACCESS_TOKEN=

# 投稿先のInstagramビジネスアカウント（プロアカウント）のユーザーID
# 数字のみのID（Instagramのユーザーネームではありません）
INSTAGRAM_USER_ID=

# 投稿する画像の公開URL（CloudinaryなどのHTTPS URL。ローカルのファイルパスは不可）
IMAGE_URL=

# 投稿につけるキャプション（本文）
CAPTION=

# 利用するGraph APIのバージョン
# 2026年8月時点の最新版は v26.0 です。
# 最新バージョンは以下のページで確認してください（英語ページです）:
# https://developers.facebook.com/docs/graph-api/changelog
GRAPH_API_VERSION=v26.0

# ---- ここから: キャプション自動生成機能（--generate-caption）用 ----

# Claude（Anthropic）のAPIキー。以下のページで発行できます:
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# キャプション生成に使うClaudeのモデル名（通常は変更不要）
CLAUDE_MODEL=claude-opus-5
