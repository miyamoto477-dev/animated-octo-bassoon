# このファイルを同じフォルダに .env という名前でコピーしてから、値を入力してください。
# 例（Windows PowerShell）: Copy-Item .env.example .env
#
# .env には秘密のアクセストークンが入るため、絶対にGitへコミットしたり人に共有したりしないこと。
# （このリポジトリの .gitignore で feed-auto/.env は除外済み）

# Instagramのビジネス/クリエイターアカウントID（数字のみ。取得方法は セットアップ手順.md 参照）
IG_USER_ID=

# Meta for Developersで発行した長期アクセストークン
# 必要な権限: instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement
ACCESS_TOKEN=

# imgbb.com の無料APIキー（投稿画像を一時的に公開URL化するために使用。 https://api.imgbb.com/ で取得）
IMGBB_API_KEY=

# 任意: 使用するGraph APIのバージョン（未指定なら v21.0）
GRAPH_API_VERSION=v21.0

# 任意: アクセストークンの有効期限が残り何日を切ったら警告を出すか（未指定なら7日）
TOKEN_EXPIRY_WARN_DAYS=7
