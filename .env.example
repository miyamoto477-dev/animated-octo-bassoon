# このファイルをコピーして .env を作成し、実際の値を入れてください。
# .env は .gitignore 済みのため、git にはコミットされません。
# 取得手順は docs/instagram-feed-auto-setup.md を参照してください。
#
#   cp .env.example .env

# Instagram Graph API の長期アクセストークン
# （instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement 権限が必要）
IG_ACCESS_TOKEN=

# 投稿先の Instagram ビジネスアカウントID（InstagramのユーザーIDではなく、Graph APIが発行するID）
IG_USER_ID=

# Imgur API の Client ID（画像をInstagramから取得できる公開URLにするために使用）
IMGUR_CLIENT_ID=

# 任意：投稿先アカウントのユーザーネーム（安全確認用。設定するとscript実行時に取得結果と突き合わせます）
EXPECTED_IG_USERNAME=

# 任意：Graph APIのバージョン（未設定時は v21.0）
GRAPH_API_VERSION=v21.0
