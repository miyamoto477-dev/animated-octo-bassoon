# LINE Developers > Messaging API チャネルから取得
LINE_CHANNEL_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LINE_CHANNEL_ACCESS_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Console > API Keys から取得
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# 使うモデル（コスト重視なら claude-haiku-4-5 / claude-sonnet-5 に変更可）
CLAUDE_MODEL=claude-opus-5

# 有人対応に切り替わったとき通知を飛ばす運用者のLINE userId（空なら通知しない）
OPERATOR_USER_ID=

# ナレッジのディレクトリ（クライアントごとに差し替える）
KNOWLEDGE_DIR=knowledge
