# このファイルを同じフォルダに .env という名前でコピーして、値を埋めてください。
# .env は git にコミットされません（.gitignore 済み）。

# --- Instagram Graph API（Meta for Developers で取得） ---
# Instagramビジネス/クリエイターアカウントに紐づく Instagram User ID
IG_BUSINESS_ACCOUNT_ID=

# instagram_basic / instagram_content_publish 権限を持つ長期アクセストークン
IG_ACCESS_TOKEN=

# --- Cloudinary（画像を一時的に公開URL化するために使用／無料プランでOK） ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=

# --- 任意設定（変更しなくてOK） ---
# feed-auto フォルダの場所（相対パスはリポジトリ直下からの相対）
# FEED_AUTO_DIR=feed-auto
# 投稿済みファイルの移動先
# POSTED_DIR=feed-auto/posted
# Graph APIのバージョン（Metaの仕様変更で古いバージョンが廃止された場合に変更）
# GRAPH_API_VERSION=v21.0
